<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="true">
    <display-name>宿舍管理系统</display-name>
    
    <!-- 登录Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.dormitory.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <!-- 登出Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.dormitory.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <!-- 用户管理Servlet -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>com.dormitory.controller.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/user/*</url-pattern>
    </servlet-mapping>
    
    <!-- 学生管理Servlet -->
    <servlet>
        <servlet-name>StudentServlet</servlet-name>
        <servlet-class>com.dormitory.controller.StudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentServlet</servlet-name>
        <url-pattern>/student/*</url-pattern>
    </servlet-mapping>
    
    <!-- 宿舍管理Servlet -->
    <servlet>
        <servlet-name>DormitoryServlet</servlet-name>
        <servlet-class>com.dormitory.controller.DormitoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DormitoryServlet</servlet-name>
        <url-pattern>/dormitory/*</url-pattern>
    </servlet-mapping>
    
    <!-- 入住登记Servlet -->
    <servlet>
        <servlet-name>CheckInServlet</servlet-name>
        <servlet-class>com.dormitory.controller.CheckInServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckInServlet</servlet-name>
        <url-pattern>/checkin/*</url-pattern>
    </servlet-mapping>
    
    <!-- 退宿管理Servlet -->
    <servlet>
        <servlet-name>CheckOutServlet</servlet-name>
        <servlet-class>com.dormitory.controller.CheckOutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckOutServlet</servlet-name>
        <url-pattern>/checkout/*</url-pattern>
    </servlet-mapping>
    
    <!-- 报修处理Servlet -->
    <servlet>
        <servlet-name>RepairServlet</servlet-name>
        <servlet-class>com.dormitory.controller.RepairServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RepairServlet</servlet-name>
        <url-pattern>/repair/*</url-pattern>
    </servlet-mapping>
    
    <!-- 欢迎页 -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- 会话超时设置 -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>